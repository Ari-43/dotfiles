# i3 config file (v4)
# Source main Sway config

# Animations
animation_duration_ms = 150

# Blur
blur enable
blur_xray disable
blur_passes 3
blur_radius 1

# Shadows
shadows enable
shadow_blur_radius 12
shadow_offset 6 6

# Window dimming
default_dim_inactive 0.1

# Borders
corner_radius 10
#smart_corner_radius true
#titlebar_separator enable

# Window rules
layer_effects "ironbar" {
	shadows enable;
	shadow_offset 0 6;
}

set $opacity E6
# target                 title     bg         text   indicator  border
client.focused           $iris     $surface$opacity   $text  $overlay   $iris

